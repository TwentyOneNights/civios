#!/usr/bin/python3
"""civios: Systemwerkzeug für CiviOS (Basis: Garuda Linux).

Befehle:
  status            Version, Kernel, GPU, Secure Boot, Snapshots, offene Updates
  update            System aktualisieren (garuda-update, vorher automatischer Snapshot)
  snapshots         Btrfs-Snapshots anzeigen
  rollback          Erklärt die Wiederherstellung und öffnet Btrfs Assistant
  compat SPIEL      Anti-Cheat-Kompatibilität eines Spiels nachschlagen
  doctor            Gaming-Stack und Systemschutz prüfen
  apps [PAKET ...]  Optionale Anwendungen installieren (ohne Angabe: ganze Liste)
  theme apply       CiviOS-Design erneut anwenden (setzt das Panel-Layout zurück)
  theme light|dark  Zwischen hellem und dunklem Farbschema wechseln
"""
import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

# Installiert: /usr/lib/civios. Im Quellbaum: ../lib/civios relativ zu diesem Skript.
for candidate in ("/usr/lib/civios",
                  str(Path(__file__).resolve().parent.parent / "lib/civios")):
    if Path(candidate, "civios_core.py").exists():
        sys.path.insert(0, candidate)
        break
import civios_core as core  # noqa: E402

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
LEVEL_COLOR = {"good": "32", "warn": "33", "info": "36", "bad": "31"}


def c(text, code):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


def confirm(question):
    if not sys.stdin.isatty():
        print("Keine interaktive Eingabe möglich, Abbruch.", file=sys.stderr)
        return False
    return input(f"{question} [j/N] ").strip().lower() in ("j", "ja", "y", "yes")


def sudo(cmd):
    if os.geteuid() != 0:
        cmd = ["sudo"] + cmd
    return subprocess.call(cmd)


def cmd_status(_args):
    name, version = core.civios_version()
    print(c(f"{name} {version}".strip(), "38;2;242;192;85"))
    print(f"  Basis:        {core.base_system()}")
    print(f"  Kernel:       {core.kernel()}")
    cpu, mem = core.cpu_name(), core.memory_gib()
    if cpu:
        print(f"  Prozessor:    {cpu}")
    if mem:
        print(f"  Arbeitssp.:   {mem} GiB")
    g = core.gpus()
    print(f"  Grafik:       {', '.join(f'{v} ({d})' for v, d in g) if g else 'nicht erkannt'}")
    print(f"  Secure Boot:  {core.secure_boot()}")
    snaps = core.snapshots()
    if snaps is None:
        print("  Snapshots:    snapper nicht verfügbar oder keine Berechtigung")
    else:
        last = snaps[-1]["date"] if snaps else "keiner"
        print(f"  Snapshots:    {len(snaps)} vorhanden, letzter: {last}")
    n = core.pending_updates()
    if n is not None:
        print(f"  Updates:      {'System ist aktuell' if n == 0 else f'{n} Pakete können aktualisiert werden'}")
    return 0


def cmd_update(_args):
    if shutil.which("garuda-update"):
        print("Starte garuda-update. Vor dem Update wird automatisch ein Snapshot angelegt.")
        return subprocess.call(["garuda-update"])
    print("garuda-update nicht gefunden, nutze pacman.")
    return sudo(["pacman", "-Syu"])


def cmd_snapshots(_args):
    snaps = core.snapshots()
    if snaps is None:
        print("Konnte die Snapshots nicht lesen. Versuche: sudo civios snapshots")
        return 1
    if not snaps:
        print("Keine Snapshots vorhanden.")
        return 0
    for s in snaps[-15:]:
        star = " *" if s["important"] else ""
        print(f"  #{s['number']:<5} {s['date']:<20} {s['type']:<7} {s['description']}{star}")
    if len(snaps) > 15:
        print(f"  ... und {len(snaps) - 15} ältere")
    return 0


ROLLBACK_TEXT = (
    "So holst du einen funktionierenden Zustand zurück:\n"
    "  1. Neu starten und im Bootmenü 'Garuda Linux snapshots' wählen.\n"
    "  2. Den Snapshot vor dem fehlerhaften Update starten.\n"
    "  3. Prüfen, ob alles läuft, dann in Btrfs Assistant den Snapshot\n"
    "     dauerhaft wiederherstellen ('Restore').\n"
    "Dein persönlicher Ordner (/home) ist davon nicht betroffen."
)


def open_btrfs_assistant():
    exe = shutil.which("btrfs-assistant-launcher") or shutil.which("btrfs-assistant")
    if exe:
        subprocess.Popen([exe], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return exe is not None


def cmd_rollback(_args):
    print(ROLLBACK_TEXT)
    if (shutil.which("btrfs-assistant-launcher") or shutil.which("btrfs-assistant")) \
            and confirm("Btrfs Assistant jetzt öffnen?"):
        open_btrfs_assistant()
    return 0


def cmd_compat(args):
    db, note = core.load_anticheat_db(args.refresh)
    if note:
        print(f"Hinweis: {note}", file=sys.stderr)
    if db is None:
        return 2
    query = " ".join(args.game)
    hits = core.search_games(db, query, args.limit)
    if not hits:
        print(f"Kein Eintrag für \"{query}\". Spiele ohne Anti-Cheat stehen nicht in "
              "dieser Datenbank; für sie ist ProtonDB die bessere Quelle.")
        return 1
    for h in hits:
        native = " · native Linux-Version" if h["native"] else ""
        print(f"{c(h['name'], '1')}  {c(h['status'], LEVEL_COLOR[h['level']])}{native}")
        if h["explanation"]:
            print(f"  {h['explanation']}")
        if h["anticheats"]:
            print(f"  Anti-Cheat: {', '.join(h['anticheats'])}")
        for n in h["notes"]:
            print(f"  - {n}")
        print()
    print("Quelle: AreWeAntiCheatYet (Community-Datenbank). Status kann sich "
          "mit jedem Spiel-Update ändern.")
    return 0


def cmd_doctor(_args):
    ok_all = True
    for name, ok, detail in core.doctor_checks():
        mark = c("OK   ", "32") if ok else c("FEHLT", "31")
        print(f"  {mark}  {name:<11} {detail}")
        ok_all &= ok
    return 0 if ok_all else 1


def cmd_apps(args):
    catalog = core.app_catalog()
    if not catalog:
        print(f"{core.APPS_LIST} fehlt oder ist leer.", file=sys.stderr)
        return 1
    wanted = set(args.packages)
    if wanted:
        unknown = wanted - {a["name"] for a in catalog}
        if unknown:
            print("Nicht in der CiviOS-Liste: " + ", ".join(sorted(unknown)), file=sys.stderr)
            return 1
        catalog = [a for a in catalog if a["name"] in wanted]
    todo, skipped = [], []
    for app in catalog:
        if app["installed"]:
            continue
        if not core.package_available(app["name"]):
            skipped.append(app["name"])
            continue
        todo.append(app)
    if skipped:
        print("Nicht in den Paketquellen gefunden, übersprungen: " + ", ".join(skipped))
    if not todo:
        print("Alles bereits installiert.")
        return 0
    print("Folgende Anwendungen werden installiert:")
    for app in todo:
        print(f"  {app['name']:<28} {app['description']}")
    if not args.yes and not confirm("Fortfahren?"):
        print("Abgebrochen.")
        return 1
    return sudo(["pacman", "-S", "--needed"] + [a["name"] for a in todo])


def cmd_theme(args):
    if args.action in ("light", "dark"):
        scheme = "CiviOSLight" if args.action == "light" else "CiviOS"
        if not shutil.which("plasma-apply-colorscheme"):
            print("plasma-apply-colorscheme nicht gefunden. Läuft KDE Plasma?", file=sys.stderr)
            return 1
        return subprocess.call(["plasma-apply-colorscheme", scheme])
    if not shutil.which("plasma-apply-lookandfeel"):
        print("plasma-apply-lookandfeel nicht gefunden. Läuft KDE Plasma?", file=sys.stderr)
        return 1
    print("Das setzt deine Panels auf das CiviOS-Layout zurück.")
    if not args.yes and not confirm("Fortfahren?"):
        return 1
    rc = subprocess.call(["plasma-apply-lookandfeel", "--apply", "org.civios.desktop",
                          "--resetLayout"])
    if shutil.which("kwriteconfig6"):
        subprocess.call(["kwriteconfig6", "--file", "konsolerc", "--group",
                         "Desktop Entry", "--key", "DefaultProfile", "CiviOS.profile"])
    return rc


def main():
    p = argparse.ArgumentParser(prog="civios", description="CiviOS-Systemwerkzeug")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="Systemzustand anzeigen").set_defaults(fn=cmd_status)
    sub.add_parser("update", help="System aktualisieren").set_defaults(fn=cmd_update)
    sub.add_parser("snapshots", help="Snapshots anzeigen").set_defaults(fn=cmd_snapshots)
    sub.add_parser("rollback", help="Wiederherstellung erklären").set_defaults(fn=cmd_rollback)
    cp = sub.add_parser("compat", help="Anti-Cheat-Kompatibilität nachschlagen")
    cp.add_argument("game", nargs="+")
    cp.add_argument("--refresh", action="store_true", help="Datenbank neu laden")
    cp.add_argument("--limit", type=int, default=5)
    cp.set_defaults(fn=cmd_compat)
    sub.add_parser("doctor", help="Gaming-Stack prüfen").set_defaults(fn=cmd_doctor)
    a = sub.add_parser("apps", help="Optionale Anwendungen installieren")
    a.add_argument("packages", nargs="*")
    a.add_argument("-y", "--yes", action="store_true")
    a.set_defaults(fn=cmd_apps)
    t = sub.add_parser("theme", help="CiviOS-Design anwenden oder hell/dunkel wechseln")
    t.add_argument("action", choices=["apply", "light", "dark"])
    t.add_argument("-y", "--yes", action="store_true")
    t.set_defaults(fn=cmd_theme)
    args = p.parse_args()
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
