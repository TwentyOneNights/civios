#!/usr/bin/python3
"""CiviOS Center: grafische Systemsteuerung für CiviOS.

Nutzt dieselbe Logik wie das Kommandozeilenwerkzeug (civios_core).
Aktionen, die Root-Rechte brauchen, laufen sichtbar in Konsole, damit man
sieht, was passiert, und das Passwort dort eingibt.
"""
import shutil
import subprocess
import sys
from pathlib import Path

for candidate in ("/usr/lib/civios",
                  str(Path(__file__).resolve().parent.parent / "lib/civios")):
    if Path(candidate, "civios_core.py").exists():
        sys.path.insert(0, candidate)
        break
import civios_core as core  # noqa: E402

from PySide6.QtCore import QObject, QRunnable, Qt, QThreadPool, QTimer, Signal, QSize  # noqa: E402
from PySide6.QtGui import QFont, QIcon, QPainter, QColor, QPixmap  # noqa: E402
from PySide6.QtSvg import QSvgRenderer  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QApplication, QButtonGroup, QCheckBox, QFrame, QGridLayout, QHBoxLayout, QLabel,
    QLineEdit, QMainWindow, QPushButton, QScrollArea, QSizePolicy, QStackedWidget,
    QVBoxLayout, QWidget,
)

LOGO = Path("/usr/share/icons/hicolor/scalable/apps/civios-logo.svg")
if not LOGO.exists():
    LOGO = Path(__file__).resolve().parent.parent / "share/icons/hicolor/scalable/apps/civios-logo.svg"

DARK = {
    "bg": "#141415", "sidebar": "#0f0f10", "card": "#1c1c1e", "card_hover": "#232326",
    "border": "#2a2a2d", "text": "#eceae6", "muted": "#96948f", "accent": "#f2c055",
    "accent_text": "#141414", "good": "#78c882", "warn": "#f2a04b", "bad": "#eb5e55",
    "info": "#6ea0eb",
}
LEVEL = {"good": "good", "warn": "warn", "info": "info", "bad": "bad"}


