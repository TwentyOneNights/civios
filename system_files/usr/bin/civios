#!/usr/bin/python3
"""civios: Systemwerkzeug für CiviOS.

Befehle:
  status          Systemversion, Image, Updates, Rollback, GPU, Secure Boot
  update          Neues Systemimage herunterladen (wird beim Neustart aktiv)
  rollback        Beim nächsten Start die vorherige Systemversion verwenden
  compat SPIEL    Anti-Cheat-Kompatibilität eines Spiels nachschlagen
  doctor          Gaming-Stack prüfen (Vulkan, GameMode, Steam, Flathub)
  setup-apps      Optionale Flatpaks aus der CiviOS-Liste installieren

Nur Python-Standardbibliothek, damit das Werkzeug auch auf einem
minimalen oder teilweise defekten System läuft.
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

AWACY_URL = ("https://raw.githubusercontent.com/AreWeAntiCheatYet/"
             "AreWeAntiCheatYet/HEAD/games.json")
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "civios"
CACHE_MAX_AGE = 24 * 3600
FLATPAK_LIST = Path("/usr/share/civios/flatpaks.list")

STATUS_DE = {
    "Supported": ("Unterstützt", "Läuft offiziell mit Anti-Cheat unter Linux/Proton."),
    "Running": ("Läuft", "Startet, Anti-Cheat ist aber nicht offiziell freigegeben. Multiplayer kann eingeschränkt sein."),
    "Planned": ("Geplant", "Der Hersteller hat Unterstützung angekündigt, sie ist aber noch nicht da."),
    "Broken": ("Defekt", "Startet nicht oder Multiplayer funktioniert nicht."),
    "Denied": ("Blockiert", "Der Hersteller blockiert Linux absichtlich. CiviOS umgeht das nicht."),
}

GPU_VENDORS = {"0x1002": "AMD", "0x10de": "NVIDIA", "0x8086": "Intel"}

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(text, code):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


def accent(t):
    return c(t, "38;2;242;192;85")


def run(cmd, check=False):
    """Führt einen Befehl aus und gibt (rc, stdout) zurück, ohne zu werfen."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, check=check)
        return p.returncode, p.stdout.strip()
    except FileNotFoundError:
        return 127, ""


def confirm(question):
    if not sys.stdin.isatty():
        print("Keine interaktive Eingabe möglich, Abbruch.", file=sys.stderr)
        return False
    return input(f"{question} [j/N] ").strip().lower() in ("j", "ja", "y", "yes")


def sudo(cmd):
    if os.geteuid() != 0:
        cmd = ["sudo"] + cmd
    return subprocess.call(cmd)


# ---------- status ----------

def read_os_release():
    data = {}
    for path in ("/etc/os-release", "/usr/lib/os-release"):
        try:
            for line in Path(path).read_text().splitlines():
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    data[k] = v.strip().strip('"')
            break
        except OSError:
            continue
    return data


def describe_entry(entry):
    """Formatiert einen Eintrag aus 'bootc status --json'."""
    if not entry:
        return None
    img = entry.get("image") or {}
    ref = (img.get("image") or {}).get("image", "unbekannt")
    version = img.get("version") or "?"
    stamp = img.get("timestamp") or ""
    return f"{ref}  Version {version}  {stamp[:10]}".rstrip()


def bootc_status():
    rc, out = run(["bootc", "status", "--json"])
    if rc != 0 or not out:
        rc, out = run(["sudo", "-n", "bootc", "status", "--json"])
    if rc != 0 or not out:
        return None
    try:
        return json.loads(out).get("status", {})
    except json.JSONDecodeError:
        return None


def detect_gpus():
    gpus = []
    for card in sorted(Path("/sys/class/drm").glob("card[0-9]*")):
        if "-" in card.name:
            continue
        try:
            vendor = (card / "device/vendor").read_text().strip()
            driver = Path(os.readlink(card / "device/driver")).name
        except OSError:
            continue
        gpus.append(f"{GPU_VENDORS.get(vendor, vendor)} (Treiber: {driver})")
    return gpus


def secure_boot_state():
    rc, out = run(["mokutil", "--sb-state"])
    if rc == 0 and out:
        return "aktiv" if "enabled" in out.lower() else "inaktiv"
    efivars = Path("/sys/firmware/efi/efivars")
    if not efivars.exists():
        return "kein UEFI (Legacy-Boot)"
    for f in efivars.glob("SecureBoot-*"):
        try:
            return "aktiv" if f.read_bytes()[-1] == 1 else "inaktiv"
        except OSError:
            break
    return "unbekannt"


def cmd_status(_args):
    osr = read_os_release()
    print(accent(osr.get("PRETTY_NAME", "CiviOS")))
    print(f"  Kernel:       {os.uname().release}")
    print(f"  Secure Boot:  {secure_boot_state()}")
    gpus = detect_gpus()
    print(f"  Grafik:       {', '.join(gpus) if gpus else 'nicht erkannt'}")

    st = bootc_status()
    if st is None:
        print("  System-Image: bootc nicht verfügbar (kein CiviOS-Image oder fehlende Rechte)")
        return 0
    print(f"  Aktiv:        {describe_entry(st.get('booted')) or 'unbekannt'}")
    staged = describe_entry(st.get("staged"))
    print(f"  Vorgemerkt:   {staged + ' (aktiv nach Neustart)' if staged else 'kein Update vorgemerkt'}")
    rollback = describe_entry(st.get("rollback"))
    print(f"  Rollback:     {rollback if rollback else 'keine vorherige Version vorhanden'}")
    return 0


# ---------- update / rollback ----------

def cmd_update(_args):
    print("Prüfe auf neues CiviOS-Image ...")
    rc = sudo(["bootc", "upgrade"])
    if rc == 0:
        print("Fertig. Ein neues Image wird erst nach einem Neustart aktiv.")
    return rc


def cmd_rollback(args):
    st = bootc_status()
    if st is not None and not st.get("rollback"):
        print("Es gibt keine vorherige Systemversion, auf die zurückgerollt werden kann.")
        return 1
    if st is not None:
        print(f"Zurück auf: {describe_entry(st.get('rollback'))}")
    if not args.yes and not confirm("Beim nächsten Start die vorherige Systemversion verwenden?"):
        print("Abgebrochen.")
        return 1
    rc = sudo(["bootc", "rollback"])
    if rc == 0:
        print("Rollback vorgemerkt. Starte neu, um ihn zu aktivieren.")
    return rc


# ---------- compat ----------

def load_awacy(refresh=False):
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    cache = CACHE_DIR / "awacy-games.json"
    fresh = cache.exists() and time.time() - cache.stat().st_mtime < CACHE_MAX_AGE
    if refresh or not fresh:
        try:
            req = urllib.request.Request(AWACY_URL, headers={"User-Agent": "civios"})
            with urllib.request.urlopen(req, timeout=15) as r:
                data = r.read()
            json.loads(data)  # nur gültiges JSON speichern
            cache.write_bytes(data)
        except Exception as e:  # noqa: BLE001
            if not cache.exists():
                print(f"Datenbank nicht erreichbar ({e}) und kein Cache vorhanden.",
                      file=sys.stderr)
                return None
            print("Hinweis: Online-Aktualisierung fehlgeschlagen, nutze Cache.",
                  file=sys.stderr)
    return json.loads(cache.read_text())


def cmd_compat(args):
    games = load_awacy(args.refresh)
    if games is None:
        return 2
    q = " ".join(args.game).casefold()
    hits = [g for g in games if q in g.get("name", "").casefold()]
    if not hits:
        print(f"Kein Eintrag für \"{' '.join(args.game)}\". "
              "Spiele ohne Anti-Cheat stehen nicht in dieser Datenbank; "
              "für sie ist ProtonDB die bessere Quelle.")
        return 1
    hits.sort(key=lambda g: (g["name"].casefold() != q, len(g["name"])))
    for g in hits[: args.limit]:
        status = g.get("status", "?")
        label, text = STATUS_DE.get(status, (status, ""))
        colour = {"Supported": "32", "Running": "33", "Planned": "36"}.get(status, "31")
        native = " · native Linux-Version" if g.get("native") else ""
        print(f"{c(g['name'], '1')}  {c(label, colour)}{native}")
        if text:
            print(f"  {text}")
        if g.get("anticheats"):
            print(f"  Anti-Cheat: {', '.join(g['anticheats'])}")
        for note in (g.get("notes") or [])[:3]:
            if isinstance(note, list) and note:
                print(f"  - {note[0]}" + (f" ({note[1]})" if len(note) > 1 and note[1] else ""))
        print()
    print("Quelle: AreWeAntiCheatYet (Community-Datenbank). Status kann sich "
          "mit jedem Spiel-Update ändern.")
    return 0


# ---------- doctor ----------

def cmd_doctor(_args):
    checks = []

    rc, out = run(["vulkaninfo", "--summary"])
    devs = [l.split("=", 1)[1].strip() for l in out.splitlines() if "deviceName" in l]
    checks.append(("Vulkan", rc == 0 and bool(devs),
                   ", ".join(devs) if devs else "vulkaninfo fehlt oder kein Vulkan-Gerät"))

    rc, out = run(["gamemoded", "-s"])
    checks.append(("GameMode", rc == 0, out or "gamemoded nicht gefunden"))

    checks.append(("MangoHud", shutil.which("mangohud") is not None, "mangohud im PATH"))

    steam = shutil.which("steam") is not None
    if not steam:
        rc, _ = run(["flatpak", "info", "com.valvesoftware.Steam"])
        steam = rc == 0
    checks.append(("Steam", steam, "installiert" if steam else "nicht gefunden"))

    rc, out = run(["flatpak", "remotes", "--columns=name"])
    checks.append(("Flathub", "flathub" in out.split(), "Flatpak-Quelle eingerichtet"
                   if "flathub" in out.split() else "flathub-Remote fehlt"))

    ok_all = True
    for name, ok, detail in checks:
        mark = c("OK  ", "32") if ok else c("FEHLT", "31")
        print(f"  {mark}  {name:<9} {detail}")
        ok_all &= ok
    return 0 if ok_all else 1


# ---------- setup-apps ----------

def cmd_setup_apps(args):
    if not FLATPAK_LIST.exists():
        print(f"{FLATPAK_LIST} fehlt.", file=sys.stderr)
        return 1
    apps = []
    for line in FLATPAK_LIST.read_text().splitlines():
        line = line.split("#", 1)
        app = line[0].strip()
        if app:
            apps.append((app, line[1].strip() if len(line) > 1 else ""))
    print("Folgende Anwendungen werden von Flathub installiert:")
    for app, desc in apps:
        print(f"  {app:<36} {desc}")
    if not args.yes and not confirm("Fortfahren?"):
        print("Abgebrochen.")
        return 1
    return subprocess.call(["flatpak", "install", "--user", "-y", "flathub"]
                           + [a for a, _ in apps])


def main():
    p = argparse.ArgumentParser(prog="civios", description="CiviOS-Systemwerkzeug")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="Systemzustand anzeigen").set_defaults(fn=cmd_status)
    sub.add_parser("update", help="Systemupdate herunterladen").set_defaults(fn=cmd_update)
    r = sub.add_parser("rollback", help="Vorherige Systemversion verwenden")
    r.add_argument("-y", "--yes", action="store_true")
    r.set_defaults(fn=cmd_rollback)
    cp = sub.add_parser("compat", help="Anti-Cheat-Kompatibilität nachschlagen")
    cp.add_argument("game", nargs="+")
    cp.add_argument("--refresh", action="store_true", help="Datenbank neu laden")
    cp.add_argument("--limit", type=int, default=5)
    cp.set_defaults(fn=cmd_compat)
    sub.add_parser("doctor", help="Gaming-Stack prüfen").set_defaults(fn=cmd_doctor)
    s = sub.add_parser("setup-apps", help="Optionale Flatpaks installieren")
    s.add_argument("-y", "--yes", action="store_true")
    s.set_defaults(fn=cmd_setup_apps)
    args = p.parse_args()
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
